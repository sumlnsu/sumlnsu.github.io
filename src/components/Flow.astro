---
// 처리 흐름 다이어그램: 단계가 순서대로 이어지는 모습을 보여 준다. 모바일에서는 세로로.
interface Props { steps: string[]; }
const { steps } = Astro.props;
---
<ol class="flow" aria-label="처리 흐름">
  {steps.map((s, i) => (
    <li class="flow__step" data-reveal style={`--i:${i}`}>
      <span class="flow__no en-label">{i + 1}</span>
      <span class="flow__label">{s}</span>
    </li>
  ))}
</ol>

<style>
  .flow { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: var(--s-6); counter-reset: f; }
  .flow__step {
    position: relative; display: grid; gap: var(--s-2); align-content: start; padding: var(--s-4) var(--s-4) var(--s-5);
    background: var(--c-surface); border: 1px solid var(--c-line); border-radius: var(--r-md);
  }
  .flow__step:not(:last-child)::after {
    content: ""; position: absolute; top: 50%; right: calc(var(--s-6) * -1 + 6px); width: calc(var(--s-6) - 12px); height: 1px;
    background: var(--c-line-strong);
  }
  .flow__step:not(:last-child)::before {
    content: ""; position: absolute; top: calc(50% - 3px); right: calc(var(--s-6) * -1 + 6px); width: 7px; height: 7px;
    border-top: 1px solid var(--c-line-strong); border-right: 1px solid var(--c-line-strong); transform: rotate(45deg);
  }
  .flow__no { font-size: var(--t-caption); color: var(--c-accent); line-height: 1; font-variant-numeric: tabular-nums; }
  .flow__label { font-size: var(--t-small); font-weight: 600; color: var(--c-ink); line-height: 1.45; }
  @media (max-width: 760px) {
    .flow { grid-auto-flow: row; gap: var(--s-5); }
    .flow__step:not(:last-child)::after { top: auto; bottom: calc(var(--s-5) * -1); right: auto; left: 28px; width: 1px; height: var(--s-5); }
    .flow__step:not(:last-child)::before { top: auto; bottom: calc(var(--s-5) * -1 + 2px); right: auto; left: 25px; transform: rotate(135deg); }
  }
</style>

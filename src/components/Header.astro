---
import { person } from '../data/profile';
---
<header class="header" data-header transition:persist>
  <div class="container header__inner">
    <a href="/" class="brand" data-home-link aria-label="홈으로">
      <span class="brand__ko">{person.name}</span>
      <span class="brand__en serif-i">{person.nameEn}</span>
    </a>
    <nav class="nav" aria-label="주요 메뉴">
      <a href="/#work" data-home-anchor="work">Work</a>
      <a href="/#about" data-home-anchor="about">About</a>
      <a href="/#contact" data-home-anchor="contact">Contact</a>
      <button class="theme-btn" type="button" data-theme-toggle aria-label="화면 테마 전환">
        <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
      </button>
    </nav>
  </div>
  <div class="progress" data-progress aria-hidden="true"></div>
</header>

<style>
  .header {
    position: sticky; top: 0; z-index: 50; height: var(--header-h);
    background: color-mix(in srgb, var(--c-bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(14px); -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: transform var(--d-base) var(--ease-out), border-color var(--d-base) var(--ease-out);
  }
  .header.is-scrolled { border-bottom-color: var(--c-line); }
  .header.is-hidden { transform: translateY(-100%); }
  .header__inner { height: 100%; display: flex; align-items: center; justify-content: space-between; }
  .brand { display: flex; align-items: baseline; gap: var(--s-2); color: var(--c-ink); }
  .brand__ko { font-weight: 700; letter-spacing: -.02em; }
  .brand__en { color: var(--c-muted); font-size: 1.05rem; }
  .nav { display: flex; align-items: center; gap: clamp(12px, 3vw, 28px); font-size: var(--t-small); font-weight: 500; }
  .nav a { color: var(--c-muted); transition: color var(--d-fast) var(--ease-out); }
  .nav a:hover { color: var(--c-ink); }
  .theme-btn {
    width: 36px; height: 36px; display: grid; place-items: center; border-radius: var(--r-pill); color: var(--c-ink);
    transition: background-color var(--d-fast) var(--ease-out), transform var(--d-base) var(--ease-out);
  }
  .theme-btn:hover { background: var(--c-surface-2); }
  .theme-btn:active { transform: rotate(-30deg) scale(.92); }
  .i-moon { display: none; }
  :global(:root[data-theme="dark"]) .i-sun { display: none; }
  :global(:root[data-theme="dark"]) .i-moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .i-sun { display: none; }
    :global(:root:not([data-theme="light"])) .i-moon { display: block; }
  }
  .progress {
    position: absolute; left: 0; bottom: -1px; height: 2px; width: 100%;
    background: var(--c-accent); transform-origin: 0 50%; transform: scaleX(var(--p, 0));
  }
  @media (max-width: 520px) { .brand__en { display: none; } .nav { gap: 14px; } }
</style>

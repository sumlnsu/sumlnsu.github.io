---
import TrackSwitch from './TrackSwitch.astro';
import { tracks, type Track } from '../data/profile';
interface Props { track: Track; }
const { track } = Astro.props;
const t = tracks[track];
---
<section class="hero container" aria-labelledby="hero-title">
  <p class="eyebrow fade-up" style="--i:0"><span class="dot" aria-hidden="true"></span>{t.role}</p>
  <h1 id="hero-title" class="hero__title">
    {t.lines.map((line, i) => (
      <span class="line-mask"><span style={`--i:${i}`}>{line}</span></span>
    ))}
  </h1>
  <p class="hero__lead fade-up" style="--i:2">{t.lead}</p>
  <div class="hero__cta fade-up" style="--i:3">
    <a href="#work" class="btn">대표 프로젝트 보기 <span class="arrow" aria-hidden="true">↓</span></a>
    <a href="#contact" class="btn btn--ghost">연락하기</a>
  </div>
  <TrackSwitch current={track} />
</section>

<style>
  .hero { padding-top: clamp(56px, 10vw, 128px); padding-bottom: var(--s-8); display: grid; gap: var(--s-5); }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--c-accent); box-shadow: 0 0 0 4px var(--c-accent-soft); }
  .hero__title { font-size: var(--t-display); font-weight: 800; line-height: 1.1; letter-spacing: -.045em; }
  .hero__lead { max-width: 600px; font-size: var(--t-lead); color: var(--c-ink-2); line-height: 1.7; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-bottom: var(--s-5); }
  @media (max-width: 520px) {
    .hero { padding-top: var(--s-8); }
    .hero__title { font-size: clamp(1.875rem, 8.6vw, 2.5rem); }
    .hero__cta .btn { flex: 1 1 auto; }
  }
</style>

---
import { person } from '../data/profile';
---
<section id="contact" class="contact section container" aria-labelledby="contact-title">
  <div class="contact__card" data-reveal>
    <p class="section-head__label"><span class="en-label">Let's talk</span><span class="eyebrow">연락하기</span></p>
    <h2 id="contact-title">더 궁금한 이야기는<br />직접 나눠요.</h2>
    <p class="contact__sub">프로젝트마다 남겨 둔 "물어봐 주세요" 질문으로 시작하셔도 좋습니다.</p>
    <div class="contact__actions">
      <button class="btn" type="button" data-copy={person.email}>
        <span>{person.email}</span><span class="contact__hint">복사</span>
      </button>
      <a class="btn btn--ghost" href={`mailto:${person.email}`}>메일 쓰기 <span class="arrow" aria-hidden="true">→</span></a>
    </div>
    <ul class="contact__links">
      {person.links.map((l) => (
        <li><a class="link" href={l.href} target="_blank" rel="noopener">{l.label} ↗</a></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .contact__card {
    display: grid; gap: var(--s-5); padding: clamp(32px, 6vw, 80px);
    border-radius: var(--r-lg); background: var(--c-brand-deep); color: var(--c-brand-ink); box-shadow: inset 0 0 0 1px var(--c-line);
  }
  .contact__card :global(.en-label) { color: #8ec5ff; }
  .contact__card .eyebrow { color: rgb(255 255 255 / .55); }
  .contact__card h2 { color: #fff; font-size: var(--t-h1); letter-spacing: -.04em; }
  .contact__sub { color: rgb(255 255 255 / .72); max-width: 52ch; }
  .contact__actions { display: flex; flex-wrap: wrap; gap: var(--s-3); --c-btn-hover: #ffffff; }
  .contact__actions .btn { --btn-bg: #fff; --btn-fg: var(--c-brand); max-width: 100%; }
  .contact__actions .btn--ghost { --btn-bg: transparent; --btn-fg: #fff; box-shadow: inset 0 0 0 1px rgb(255 255 255 / .35); }
  .contact__hint { font-size: var(--t-micro); padding: 2px 8px; border-radius: var(--r-pill); background: #e8f2fd; color: var(--c-brand); }
  .contact__links { display: flex; flex-wrap: wrap; gap: var(--s-5); }
  .contact__links .link { display: inline-block; padding-block: 10px; }
  @media (max-width: 520px) {
    .contact__actions .btn { width: 100%; }
    .contact__card h2 br { display: none; }
  }
  .contact__links .link { color: #fff; }
</style>

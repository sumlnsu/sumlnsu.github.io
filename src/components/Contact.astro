---
import { person } from '../data/profile';
---
<section id="contact" class="contact section container" aria-labelledby="contact-title">
  <div class="contact__card" data-reveal>
    <p class="section-head__label"><span class="serif-i">Let's talk</span><span class="eyebrow">연락하기</span></p>
    <h2 id="contact-title">더 궁금한 이야기는<br />직접 나눠요.</h2>
    <p class="contact__sub">프로젝트마다 남겨 둔 "물어봐 주세요" 질문으로 시작하셔도 좋습니다.</p>
    <div class="contact__actions">
      <button class="btn" type="button" data-copy={person.email}>
        <span>{person.email}</span><span class="contact__hint">복사</span>
      </button>
      <a class="btn btn--ghost" href={`mailto:${person.email}`}>메일 쓰기 <span class="arrow" aria-hidden="true">→</span></a>
    </div>
    <ul class="contact__links">
      {person.links.map((l) => (
        <li><a class="link" href={l.href} target="_blank" rel="noopener">{l.label} ↗</a></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .contact__card {
    display: grid; gap: var(--s-5); padding: clamp(32px, 6vw, 80px);
    border-radius: var(--r-lg); background: var(--c-ink); color: var(--c-bg);
  }
  .contact__card :global(.serif-i) { color: var(--c-bg); font-size: 1.5rem; }
  .contact__card .eyebrow { color: color-mix(in srgb, var(--c-bg) 60%, transparent); }
  .contact__card h2 { color: var(--c-bg); font-size: var(--t-h1); letter-spacing: -.04em; }
  .contact__sub { color: color-mix(in srgb, var(--c-bg) 70%, transparent); max-width: 52ch; }
  .contact__actions { display: flex; flex-wrap: wrap; gap: var(--s-3); }
  .contact__actions .btn { --btn-bg: var(--c-bg); --btn-fg: var(--c-ink); }
  .contact__actions .btn--ghost { --btn-bg: transparent; --btn-fg: var(--c-bg); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c-bg) 35%, transparent); }
  .contact__hint { font-size: var(--t-micro); padding: 2px 8px; border-radius: var(--r-pill); background: var(--c-surface-2); color: var(--c-muted); }
  .contact__links { display: flex; flex-wrap: wrap; gap: var(--s-5); }
  .contact__links .link { color: var(--c-bg); }
</style>

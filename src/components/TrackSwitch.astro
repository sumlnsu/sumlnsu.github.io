---
import { tracks, trackOrder, type Track } from '../data/profile';
interface Props { current: Track; }
const { current } = Astro.props;
---
<div class="switch" data-reveal style="--i:5">
  <p class="switch__hint" id="track-hint">같은 경험을 직무 관점으로 다시 정렬해 보여드려요</p>
  <nav class="switch__bar" aria-labelledby="track-hint">
    {trackOrder.map((t) => (
      <a href={tracks[t].path} class:list={['switch__item', { 'is-active': t === current }]} aria-current={t === current ? 'page' : undefined} data-astro-history="replace">
        {t === current && <span class="switch__pill" transition:name="track-pill" aria-hidden="true" />}
        <span class="switch__label">{tracks[t].tab}</span>
      </a>
    ))}
  </nav>
</div>

<style>
  .switch { display: grid; gap: var(--s-3); justify-items: start; }
  .switch__hint { font-size: var(--t-caption); color: var(--c-muted); }
  .switch__bar {
    display: inline-flex; padding: 4px; gap: 2px; border-radius: var(--r-pill);
    background: var(--c-surface-2); box-shadow: inset 0 0 0 1px var(--c-line);
  }
  .switch__item {
    position: relative; display: grid; place-items: center; min-width: 64px; height: 40px; padding: 0 var(--s-4);
    border-radius: var(--r-pill); font-size: var(--t-small); font-weight: 600; color: var(--c-muted);
    transition: color var(--d-fast) var(--ease-out);
  }
  .switch__item:hover { color: var(--c-ink); }
  .switch__item.is-active { color: var(--c-ink); }
  .switch__pill { position: absolute; inset: 0; border-radius: inherit; background: var(--c-surface); box-shadow: var(--shadow-1); }
  .switch__label { position: relative; }
  @media (max-width: 520px) {
    .switch, .switch__bar { width: 100%; }
    .switch__item { flex: 1; min-width: 0; padding: 0; height: 44px; }
  }
</style>

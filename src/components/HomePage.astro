---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Metric from './Metric.astro';
import WorkList from './WorkList.astro';
import About from './About.astro';
import Toolkit from './Toolkit.astro';
import Contact from './Contact.astro';
import { tracks, type Track } from '../data/profile';

interface Props { track: Track; }
const { track } = Astro.props;
const t = tracks[track];
const items = (await getCollection('work'))
  .filter((p) => p.data.order[track] !== null)
  .sort((a, b) => a.data.order[track]! - b.data.order[track]!);
---
<Base title={t.title} description={t.lead.replace('\n', ' ')}>
  <div data-track-path={t.path}>
    <Hero track={track} />

    <section class="container metrics" aria-label="핵심 성과">
      {t.metrics.map((m, i) => (
        <div data-reveal style={`--i:${i}`}><Metric {...m} /></div>
      ))}
    </section>

    <section id="work" class="section container" aria-labelledby="work-title">
      <div class="section-head" data-reveal>
        <p class="section-head__label"><span class="en-label">Selected work</span><span class="eyebrow">{t.tab === '전체' ? '전체 프로젝트' : `${t.tab} 관점 프로젝트`}</span></p>
        <h2 id="work-title">무엇을, 왜, 어떻게 바꿨는지</h2>
        <p>각 프로젝트는 30초 요약부터 시작합니다. 더 궁금한 부분만 골라 읽으셔도 됩니다.</p>
      </div>
      <WorkList items={items} />
    </section>

    <About />
    <Toolkit track={track} />
    <Contact />
  </div>
</Base>

<style>
  .metrics {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-6); align-items: start;
    padding-block: var(--s-7); border-block: 1px solid var(--c-line);
  }
  @media (max-width: 860px) { .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-6) var(--s-5); } }
</style>
